# Copy this file to `.env` and fill in real values before `docker compose up`.
# NEVER commit the real `.env` to git.

# --- Database ---
# Strong SA password (single knob used by db + api + healthcheck)
SA_PASSWORD=ChangeMe_Strong_Password_123

# --- Frontend ---
# Public URL of the deployed frontend (comma-separated if more than one)
FrontendOrigins=https://your-frontend-domain.com

# --- JWT (must be long random secrets in production) ---
JWT__Secret=CHANGE_ME_to_a_long_random_secret_at_least_64_chars
JWT__ValidIssuer=StudentHousingPlatform
JWT__ValidAudience=StudentHousingPlatform.Client

# --- Default admin (created on first run) ---
DefaultAdmin__Email=admin@example.com
DefaultAdmin__Password=CHANGE_ME_Strong_Admin_Password

# --- Cloudinary (image uploads; leave empty to disable) ---
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- Paymob (online payments; leave empty to disable) ---
Paymob__ApiKey=
Paymob__PublicKey=
Paymob__HmacSecret=
Paymob__CardIntegrationId=
Paymob__WalletIntegrationId=
Paymob__IframeId=
Paymob__FrontendResultUrl=https://your-frontend-domain.com/payment/result
